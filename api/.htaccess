# Запрет прямого доступа по URL к служебным файлам (конфигурация, подключение,
# помощники). Эндпоинты (register/login/restore/logout/state/users/ping) остаются
# доступными — они подключают служебные файлы через require, а не по URL.

<FilesMatch "^(config|db|common|common_header)\.php$">
    Require all denied
</FilesMatch>
