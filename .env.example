# ============================================================
# КАДР · переменные окружения для сборки
# ============================================================
# Скопируйте этот файл в .env.production и заполните нужные значения.
# Vite подхватит их автоматически при сборке (npm run build) — работает и
# при «импорте из Git», когда хост собирает проект сам.
# ============================================================

# ---------- 1. БД на reg.ru (MySQL + PHP-API) — РЕКОМЕНДУЕТСЯ ----------
# Режим сервисного слоя: regapi | (пусто → supabase, если задан; иначе local).
# В workflow .github/workflows/deploy-regru.yml уже прописано regapi по
# умолчанию, и этот режим имеет ПРИОРИТЕТ над Supabase.
VITE_BACKEND=regapi

# Базовый путь PHP-API. По умолчанию "/api" — тот же домен, что и сайт
# (https://kadr-scr.ru/api/...), поэтому CORS не требуется.
VITE_API_BASE=/api

# Реквизиты самой MySQL задаются НЕ здесь, а в api/config.php (серверная часть).

# ---------- 2. Supabase (облако) — ОПЦИОНАЛЬНО ----------
# Нужны, только если вы НЕ используете regapi. Ключи: Supabase → Settings → API.
# ВАЖНО: VITE_SUPABASE_URL — БЕЗ суффикса "/rest/v1" (иначе ошибка 404).
#VITE_SUPABASE_URL=https://xxxx.supabase.co
#VITE_SUPABASE_ANON_KEY=your-anon-public-key-here
