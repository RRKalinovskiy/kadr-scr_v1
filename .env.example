# ============================================================
# КАДР · подключение облачной БД (Supabase)
# ============================================================
# Скопируйте этот файл в .env.production и вставьте свои ключи.
# Vite подхватит их автоматически при сборке (npm run build) —
# это работает и при «импорте из Git», когда хост собирает проект сам.
#
# Ключи брать в Supabase: Settings → API
#   - Project URL  → VITE_SUPABASE_URL
#   - anon public  → VITE_SUPABASE_ANON_KEY
#
# ВАЖНО: anon-ключ — публичный по дизайну Supabase (предназначен для
# клиентского кода). Доступ к данным защищён RLS-политиками, поэтому
# коммитить его в репозиторий безопасно. НЕ используйте service_role key!
# ============================================================

VITE_SUPABASE_URL=https://xxxx.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key-here

# ============================================================
# РЕЖИМ 2: БД на хостинге reg.ru (MySQL + PHP-API из папки api/)
# ============================================================
# Используется, когда ключи Supabase НЕ заданы (приоритет у Supabase).
#   VITE_BACKEND=regapi  — включить PHP-API на reg.ru
#   VITE_API_BASE        — база URL эндпоинтов (по умолчанию /api, тот же домен)
# Перед включением: создайте БД в reg.ru, примените mysql/schema.sql
# и заполните api/config.php.
# ============================================================
VITE_BACKEND=regapi
VITE_API_BASE=/api
